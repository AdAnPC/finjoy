{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "node --env-file=.env scripts/dev-local.cjs",
    "dev:local": "node --env-file=.env scripts/dev-local.cjs",
    "build": "node ./node_modules/vite/bin/vite.js build --config ./artifacts/admin-panel/vite.config.ts && node ./artifacts/api-server/build.mjs",
    "start": "node --enable-source-maps ./artifacts/api-server/dist/index.mjs",
    "preinstall": "node scripts/preinstall.cjs",
    "db:push:local": "node --env-file=.env scripts/push-db-local.cjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
