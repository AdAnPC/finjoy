      </intent-filter>
      <intent-filter>
        <action android:name="android.app.action.PROVISIONING_SUCCESSFUL"/>
        <category android:name="android.intent.category.DEFAULT"/>
      </intent-filter>
    </activity>
    <receiver android:name=".FinJoyDeviceAdminReceiver" android:label="FinJoy Control de Crédito" android:permission="android.permission.BIND_DEVICE_ADMIN" android:exported="true">
      <intent-filter>
