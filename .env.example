# Copia este archivo a .env y usa una base PostgreSQL de DESARROLLO.
# No uses credenciales de producción para ejecutar o modificar el esquema local.
DATABASE_URL=postgresql://finjoy:CAMBIA_ESTA_CLAVE@localhost:5432/finjoy

# Opcionales para pnpm dev:local
FINJOY_API_PORT=8080
FINJOY_ADMIN_PORT=5173

# Almacenamiento privado de APK para el API. En Replit se conserva App Storage.
APK_STORAGE_PROVIDER=replit

# Para alojar el API fuera de Replit, cambia el proveedor a "s3" y configura
# un almacén compatible con S3 (AWS S3, Cloudflare R2, MinIO, etc.).
# APK_STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
