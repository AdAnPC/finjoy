# Copia este archivo a .env y usa una base PostgreSQL de DESARROLLO.
# No uses credenciales de producción para ejecutar o modificar el esquema local.
DATABASE_URL=postgresql://finjoy:CAMBIA_ESTA_CLAVE@localhost:5432/finjoy

# Opcionales para pnpm dev:local
FINJOY_API_PORT=8080
FINJOY_ADMIN_PORT=5173

# La subida de APK en el backend actual usa App Storage de Replit.
# Fuera de Replit se debe configurar otro servicio antes de usar esta función.
